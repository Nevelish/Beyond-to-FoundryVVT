{
  "manifest_version": 2,
  "name": "DnD Beyond to FoundryVTT",
  "version": "1.0.0",
  "description": "Easy import of characters from DnD Beyond into FoundryVTT. Copy cobalt cookies and character data with ease.",
  "author": "Nevelish",
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  },
  "permissions": [
    "cookies",
    "activeTab",
    "clipboardWrite",
    "*://*.dndbeyond.com/*"
  ],
  "browser_action": {
    "default_icon": "icons/icon-48.png",
    "default_title": "DnD Beyond to FoundryVTT",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.dndbeyond.com/characters/*"],
      "js": ["content/content.js"]
    }
  ],
  "background": {
    "scripts": ["background/background.js"]
  }
}
